# Copy this file to .env and adjust the values:
#   cp .env.example .env
# .env is read by docker compose and is not committed to git.

# --- PostgreSQL ---
# Note: user/password are applied once, when the database volume is first created.
# Avoid characters that need URL-encoding (@ : / ? #) in the password,
# because it is also placed into DATABASE_URL.
POSTGRES_USER=autoservice
POSTGRES_PASSWORD=change-me
POSTGRES_DB=autoservice

# --- Backend ---
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend ---
# Address of the backend as seen from the browser.
VITE_API_URL=http://localhost:8000

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
